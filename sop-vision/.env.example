# 复制为 .env 并填入真实值。.env 已被 .gitignore 排除,绝不提交、绝不写日志。
# 凭据泄露过一次就轮换;建议在智谱控制台定期轮换 API key。
ZHIPU_API_KEY=在此填入
ZHIPU_BASE=https://open.bigmodel.cn/api/coding/paas/v4
ZHIPU_MODEL=glm-5.3-flash
ZHIPU_TIMEOUT=120

# 原生 Monibuca 服务：Windows / Linux 相同；不需要 Docker。
# MONIBUCA_URL=http://127.0.0.1:8180
# v6 默认 /webrtc/whep；官方 v5.1.6 用 /webrtc/play，必须显式选择。
# MONIBUCA_WHEP_PREFIX=/webrtc/whep
# 工位 YAML 的 source.preview_stream 填流路径，例如 live/camera01。
# MONIBUCA_RECORD_DIR=/absolute/path/to/monibuca/recordings
# Windows 可写 D:/StepEye/monibuca/recordings；录像文件名时间按 UTC+08:00。

# 可选相机依赖：pip install -r requirements-camera.txt
# ONVIF 默认只允许 RFC1918/IPv6 ULA 管理网；明确授权后才加其它网段。
# ONVIF_ALLOWED_CIDRS=127.0.0.0/8
# ONVIF_HOST=192.168.1.20
# ONVIF_PORT=80
# ONVIF_USER=在本机填写
# ONVIF_PASS=在本机填写
# GB28181_WVP_URL=http://192.168.1.10:18080
# GB28181_USER=在本机填写
# GB28181_PASS=在本机填写
